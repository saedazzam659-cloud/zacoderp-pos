modules = ["nodejs-24", "javascript", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "admin-reports-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "tmp-full-build"

[[workflows.workflow]]
name = "admin-reports-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "tmp-full-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && (time pnpm -r --workspace-concurrency=1 --if-present run build) > /home/runner/workspace/.local/fullbuild.log 2>&1; echo EXIT=$? >> /home/runner/workspace/.local/fullbuild.log"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["outlook:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
PG_POOL_MAX = "30"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18924
externalPort = 80

[[ports]]
localPort = 19225
externalPort = 3002

[[ports]]
localPort = 19226
externalPort = 5000

[[ports]]
localPort = 20655
externalPort = 3000

[[ports]]
localPort = 24730
externalPort = 3001

[[ports]]
localPort = 24731
externalPort = 3003
