# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Historic source-code snapshots (~117 MB) used for download/backup only.
# They have no role in the production runtime and bloated the publish
# snapshot enough to make the deployer time out before it could begin
# building. Keep the local copies, just don't ship them.
exports/*.tar
exports/*.tar.gz
exports/*.zip

# Local caches that must never ship. Note: do NOT exclude artifacts/*/dist
# here — the cloud build writes the production bundles into those folders
# and the runtime image needs them. Excluding them caused the runtime to
# fail with "Cannot find module artifacts/api-server/dist/index.mjs" and
# "static artifact publicDir does not exist".
artifacts/*/.next
artifacts/*/.vite
artifacts/*/node_modules

# Repo-wide caches that should never leave the dev container.
node_modules
.cache
.pnpm-store
*.log
.git
