# ─────────────────────────────────────────────────────────────────────────────
# Zacod ERP — Environment Variables (example)
# Copy this file to `.env` at the project root and fill each value.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Must point to a database you have created
# (e.g. `createdb zacoderp`). The Drizzle push command will create tables.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/zacoderp

# Random long string used to sign session cookies / JWTs.
# Generate one with: `openssl rand -hex 48`
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# ── Object storage (invoice attachments, backups, item images) ──────────────
# Leave blank in local dev — attachments will fail silently. For production,
# point these at any S3-compatible bucket you own (Replit App Storage,
# Cloudflare R2, AWS S3, etc.)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=/private
PUBLIC_OBJECT_SEARCH_PATHS=/public

# ── Optional: AI-assisted features (accounting mapping suggestions, etc.) ──
# The app calls OpenAI-compatible endpoints for AI account-suggestion and
# invoice-to-draft extraction. Leave blank to disable those buttons.
# On Replit, these are auto-populated by the AI Integrations proxy.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Optional: runtime tuning ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# The Vite dev servers read PORT per-artifact; in production deployment the
# process manager assigns these automatically.
# PORT=8080
