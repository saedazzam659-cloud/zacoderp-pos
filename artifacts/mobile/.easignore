# Keep existing project exclusions in sync with .gitignore.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# Archived Play Store bundles are build artifacts, not Launch source files.
/releases/*.aab

# typescript
*.tsbuildinfo
.vercel
