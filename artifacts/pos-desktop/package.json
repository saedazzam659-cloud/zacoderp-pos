{
  "name": "@workspace/pos-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Windows POS desktop app (Tauri + React + SQLite). Browser preview enabled via Vite; native MSI built on Windows via GitHub Actions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
